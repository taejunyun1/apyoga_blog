{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ap-yoga-content-studio",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-07-11",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "AUTH_RATE_LIMIT",
			"id": "06dfdd53bfeb46c398bd156a8042099b"
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "ap-yoga-auth",
			"database_id": "1977c3b0-2ddc-43c8-908b-338571ae7b3d"
		}
	]
}
