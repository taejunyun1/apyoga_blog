{
  "name": "ap-yoga-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run typecheck:functions && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "PLAYWRIGHT_AUTH=1 playwright test",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "auth:provision": "node scripts/provision-auth.mjs",
    "openai:provision": "node scripts/provision-openai.mjs",
    "predeploy:cloudflare": "npm run build",
    "deploy:cloudflare": "wrangler pages deploy --branch master"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@vueuse/core": "^14.3.0",
    "dexie": "^4.4.4",
    "heic2any": "^0.0.4",
    "konva": "^10.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-konva": "^3.4.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.110.0"
  }
}
